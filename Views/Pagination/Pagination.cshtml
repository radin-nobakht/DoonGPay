@using DoonGPay.ViewModel
@model PagationModel
<nav>
    <ul class="pagination">
        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
            <a href="@(Model.Url)@(Model.CurrentPage - 1)" class="page-link">Previous</a>
        </li>
        @if (Model.ShowFirstPage != 1 && Model.ShowFirstPage != 2)
        {
            <li class="page-item ">
                <a class="page-link" href="@(Model.Url)1">1</a>
            </li>
            <li class="page-item">
                <p class="page-link">...</p>
            </li>
        }
        @if (Model.ShowFirstPage == 2)
        {
            <li class="page-item ">
                <a class="page-link" href="@(Model.Url)1">1</a>
            </li>
        }
        @for (var i = Model.ShowFirstPage; Model.ShowLastPage >= i; i++)
        {
            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                <a class="page-link" href="@(Model.Url)@(i)">@(i)</a>
            </li>
        }
        @if (Model.ShowLastPage != Model.TotalPage && Model.ShowLastPage != Model.TotalPage - 1)
        {
            <li class="page-item">
                <p class="page-link">...</p>
            </li>
            <li class="page-item ">
                <a class="page-link" href="@(Model.Url)@(Model.TotalPage)">@(Model.TotalPage)</a>
            </li>
        }
        @if (Model.ShowLastPage == Model.TotalPage - 1 && Model.ShowLastPage != Model.TotalPage)
        {
            <li class="page-item ">
                <a class="page-link" href="@(Model.Url)@(Model.TotalPage)">@(Model.TotalPage)</a>
            </li>
        }
        <li class="page-item @(Model.CurrentPage == Model.TotalPage ? "disabled" : "")">
            <a class="page-link" href="@(Model.Url)@(Model.CurrentPage + 1)">Next</a>
        </li>
    </ul>
</nav>