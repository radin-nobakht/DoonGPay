@using DoonGPay.Dto.Travel
@model TravelDto

<style>
    /* استایل کلی جدول‌ها */
    table.table {
        background-color: #fff;
        border-collapse: collapse;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
        border-radius: 10px;
        overflow: hidden;
    }

    img {
        width: 20px;
    }

    table.table thead {
        background-color: #343a40;
        color: white;
    }

    table.table th,
    table.table td {
        vertical-align: middle;
        font-size: 14px;
    }

    /* ردیف‌های جدول هنگام هاور */
    table.table tbody tr:hover {
        background-color: #f2f2f2;
        transition: 0.2s ease-in-out;
    }

    /* استایل دکمه‌ها */
    button.btn {
        border-radius: 6px !important;
        font-size: 13px !important;
        padding: 6px 14px !important;
        min-width: 70px;
    }

    /* دکمه ویرایش */
    button.btn-info {
        background-color: #17a2b8;
        border-color: #17a2b8;
        color: white;
    }

    /* دکمه حذف */
    button.btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
        color: white;
    }

    /* دکمه افزودن */
    button.btn-success {
        background-color: #28a745;
        border-color: #28a745;
        color: white;
    }

    /* فاصله بین دکمه‌ها */
    button + button {
        margin-right: 5px;
    }

    /* فاصله دکمه بالا */
    .mb-3 {
        margin-bottom: 15px !important;
        font-weight: bold;
    }

</style>
<div id="travelAndCostAndFriend ">
    <button class="btn btn-success btnEditTravel" id="btnAddTravel" data-id="0">سفر جدید</button>

    <button type="button" class="btn btn-primary" id="morebtn">بیشتر</button>

    <link href="~/css/travel/travelstable.css" rel="stylesheet" />

    @if (Model != null)
    {
        <div class="p-2 bg-light rounded shadow-sm d-inline-flex align-items-center gap-2" data-id="@Model.Id">
            <span class="fw-bold">@Model.Name</span>
            <span>
                <strong>تاریخ:</strong>
                @Model.InsertDate
            </span>
            <span>
                <strong>تعداد نفرات:</strong>
                @Model.AllPerson
            </span>
            <span>
                <strong>کل هزینه:</strong>
                @string.Format("{0:N0}", Model.AllCost)
            </span>
            <button class="btn btn-info btn-sm btnEditTravel" data-id="@Model.Id">
                <i class="fa-solid fa-pen-to-square"></i>
            </button><button class="btn btn-danger btn-sm btnDeleteTravel" data-id="@Model.Id">
                <i class="fa-solid fa-trash"></i>
            </button>
        </div>
    }
    <div class="container ">
        <div class="row">


            <div class="col-6">
                <div id="travelCosts">
                    <partial name="_TravelCost" model="Model.TravelCosts" />
                </div>
            </div>@*cost*@
            <div class="col-6">
                <div id="travelFriend">
                    <partial name="_TravelFriend" model="Model.TravelFriends" />
                </div>
            </div>@*friend*@

        </div>

    </div>




</div>