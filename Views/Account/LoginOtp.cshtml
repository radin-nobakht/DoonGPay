@{
    Layout = "_Layout2";
    ViewBag.Title = "ورود به سیستم";
}
<style>
    #loginTemplate{
      border-radius:8px ;
        border:1px solid var(--color-neutral-200)
    }
    </style>
<div class="d-flex justify-content-center align-items-center vh-100" style="background-color:#f8f9fa;">
    <div class="card shadow-lg  rounded-4 p-4 text-dark" id="loginTemplate" style="max-width: 420px; width: 100%; background-color:#ffffff;">
        <h3 class="text-center mb-4" style="color:#1e2761;">ورود به سیستم</h3>

        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {
            <div class="alert alert-danger text-center rounded-3">@ViewBag.Error</div>
        }

        <form asp-action="Login" asp-controller="Account" method="post">
            <div class="mb-3">
                <label class="form-label" style="color:#1e2761;">نام کاربری</label>
                <input type="text" name="UserName" id="userName" class="form-control rounded-3 border-primary" placeholder="نام کاربری" required />
            </div>

            <div class="mb-3">
                <label class="form-label" style="color:#1e2761;">رمز عبور</label>
                <input type="password" name="Password" id="password" class="form-control rounded-3 border-primary" placeholder="رمز عبور" required />
            </div>

            <button type="button" id="btnLoginOtp" class="btn btn-primary w-100 rounded-3">ورود</button>
        </form>

        <div class="text-center mt-3">
            <a href="@Url.Action("Register", "Account")" class="text-decoration-none btn btn-primary " style="color:white;">ثبت نام</a>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $("#btnLoginOtp").click(function(){
            $.ajax({
                type: "POST",
                url: "/Account/LoginOtp",
                data: {
                    Password: $("#password").val(),
                    UserName: $("#userName").val(),
                },
                success: function (result) {
                    if(result.result) {
                        window.location.href="/Home";
                    } else {
                        alert(result.message);
                    }
                },
                error: function () {
                    alert("خطا در ارسال اطلاعات");
                }
            });
        });
    </script>
}
