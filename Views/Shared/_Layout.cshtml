<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DoonGPay</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.css" />
    <!-- Persian Datepicker -->
    <link rel="stylesheet" href="~/lib/pwt.datepicker-master/dist/css/persian-datepicker.css" />
    <link href="~/lib/vazir-font/font-face.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DoonGPay.styles.css" asp-append-version="true" />
    <style>
        /* ====== Global ====== */
        body {
            background-color: #E0F7FA
        }

        /* ====== Navbar ====== */
        .navbar {
            background-color: #1e2761 !important; /* سرمه‌ای */
        }

            .navbar .nav-link,
            .navbar .navbar-brand {
                color: #ffffff !important;
                transition: color 0.3s ease;
            }

                .navbar .nav-link:hover {
                    color: #408ec6 !important; /* آبی روشن */
                }

        /* ====== Buttons ====== */
        .btn-primary {
            background-color: #408ec6;
            border-color: #408ec6;
        }

            .btn-primary:hover {
                background-color: #1e2761;
                border-color: #1e2761;
            }

        .btn-danger {
            background-color: #7a2048;
            border-color: #7a2048;
        }

            .btn-danger:hover {
                background-color: #5c1435;
                border-color: #5c1435;
            }

        /* ====== Footer ====== */
        footer {
            background-color: #1e2761;
            color: #ffffff;
        }

        /* ====== Links ====== */
        a {
            color: #408ec6;
            text-decoration: none;
        }

            a:hover {
                color: #7a2048;
                text-decoration: underline;
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Navbar -->
    @await Component.InvokeAsync("Navbar")

    <!-- Main Content -->
    <main class="flex-grow-1 container my-3">
        @RenderBody()
        <div id="modal"></div>
    </main>

    <!-- Footer -->
    <footer class="text-center py-3 mt-auto">
        @Html.Partial("_Footer")
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/persian-date/dist/persian-date.js"></script>
    <script src="~/lib/pwt.datepicker-master/dist/js/persian-datepicker.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
