@using DoonGPay.ViewModel
@model UserViewModel
<style>


    .dropdown {
        display: inline-block;
        position: relative;
    }

    .dropdown-menu {
        position: absolute;
        right: auto;
        left: 0px;
        top: 100%;
        min-width: 180px;
        text-align: center;
        padding: 10px;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
        z-index: 1000;
    }

    .dropdown img {
        cursor: pointer;
        border-radius: 50%;
    }
</style>
<div class="d-flex align-items-center justify-content-end p-2" style="background-color:#1e2761;">
    @if (Model.IsLogin)
    {
        <div class="dropdown text-end">
            <!-- عکس کاربر -->
            <a href="#" id="userMenuToggle" data-bs-toggle="dropdown" aria-expanded="false">
                <img src="@Model.Image" width="40" height="40" alt="User" />
            </a>

            <!-- منو -->
            <ul class="dropdown-menu shadow" aria-labelledby="userMenuToggle">
                <li class="mb-2">
                    <span class="fw-bold">@Model.Name</span>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a href="@Url.Action("Logout", "Account")"
                       class="dropdown-item text-danger fw-semibold">خروج</a>
                </li>
            </ul>
        </div>
    }
    else
    {
        <a class="btn me-2" style="background-color:#408ec6; color:white;" href="/Login">ورود</a>
        <a class="btn" style="background-color:#7a2048; color:white;" href="/signin">ثبت نام</a>
    }
</div>
@section Scripts {

    <script>
        $(function () {
            let clicked = false;

            // هاور روی عکس
            $('#userMenuToggle img').on('mouseenter', function () {
                if (!clicked) {
                    bootstrap.Dropdown.getOrCreateInstance($('#userMenuToggle')[0]).show();
                }
            }).on('mouseleave', function () {
                if (!clicked) {
                    bootstrap.Dropdown.getOrCreateInstance($('#userMenuToggle')[0]).hide();
                }
            });

            // کلیک روی عکس
            $('#userMenuToggle').on('click', function (e) {
                e.preventDefault();
                let bsDropdown = bootstrap.Dropdown.getOrCreateInstance(this);
                if (clicked) {
                    bsDropdown.hide();
                    clicked = false;
                } else {
                    bsDropdown.show();
                    clicked = true;
                }
            });

            // کلیک بیرون از منو
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.dropdown').length) {
                    bootstrap.Dropdown.getOrCreateInstance($('#userMenuToggle')[0]).hide();
                    clicked = false;
                }
            });
        });
    </script>
}
