    <script>
            $.ajax({
            url: "/Home/Index2",
            type: "Post",
            success: function (result) {
               

                // نمایش/پنهان جدول دستی
                var value = $("#Type").val();
                if (value == 3 || value == 4 || value == 5) {
                    $("#manual").show();
                    $("#typeStr").text(value == 3 ? "نفرات" : value == 4 ? "درصد" : "مقدار");
                } else {
                    $("#manual").hide();
                }
            },
            error: function () {
                $("#errorMessage").text("خطا در بارگذاری فرم هزینه").show();
            }
        });
