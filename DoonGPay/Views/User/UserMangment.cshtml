@using DoonGPay.Dto
@model List<UserDto>

<style>
    body {
        direction: rtl;
        background-color: #f0f4ff; /* آبی خیلی روشن برای زمینه */
        margin-bottom: 60px;
    }

    /* فرم و مودال */
    .form-container {
        width: 400px;
        margin: 20px auto;
        background-color: #1e2761; /* آبی تیره */
        padding: 20px;
        border-radius: 10px;
        color: white;
    }

        .form-container h2, .form-container h5 {
            text-align: center;
            color: #408ec6; /* آبی روشن */
        }

        .form-container input {
            width: 100%;
            padding: 8px;
            margin: 8px 0;
            border: 1px solid #408ec6;
            border-radius: 8px;
            background-color: #f0f4ff;
            color: #1e2761;
            font-size: 14px;
            transition: border-color 0.3s;
        }

            .form-container input:focus {
                border-color: #7a2048; /* بنفش/شرابی */
                outline: none;
                background-color: #e0e7ff;
            }

        .form-container button {
            width: 100%;
            padding: 10px;
            background-color: #408ec6;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            .form-container button:hover {
                background-color: #1e2761;
            }

    .error {
        color: #ff6f61;
        font-size: 14px;
        margin-bottom: 10px;
        display: none;
    }

    /* جدول */
    table {
        border-collapse: collapse;
        width: 100%;
        max-width: 900px;
        margin: 20px auto 50px;
        font-family: Tahoma, sans-serif;
        box-shadow: 0 0 8px rgba(64, 142, 198, 0.4);
    }

    th {
        background-color: #408ec6;
        color: white;
        padding: 10px;
        border: 1px solid #1e2761;
        text-align: center;
    }

    td {
        padding: 10px;
        border: 1px solid #ddd;
        text-align: center;
        color: #1e2761;
    }

    tbody tr:nth-child(even) {
        background-color: #e0e7ff;
    }

    tbody tr:hover {
        background-color: #d0e0ff;
    }

    .btn {
        padding: 5px 10px;
        border-radius: 5px;
        font-size: 14px;
        cursor: pointer;
        border: none;
        color: white;
        transition: background-color 0.3s;
    }

    .btn-update {
        background-color: #408ec6;
    }

    .btn-delete {
        background-color: #7a2048;
    }

    .btn-update:hover {
        background-color: #1e2761;
    }

    .btn-delete:hover {
        background-color: #5e1e44;
    }

    #btnAdd {
        margin: 15px;
        background-color: #408ec6;
    }

        #btnAdd:hover {
            background-color: #1e2761;
        }

</style>
@* @await Component.InvokeAsync("Pagation", Model.PagationModel)
 *@
<button class="btn btn-success mb-3" id="btnAdd">کاربر جدید</button>

<table class="table table-bordered text-center" id="userTable">
    <thead>
        <tr>
            <th>ویرایش</th>
            <th>حذف</th>
            <th>نام</th>
            <th>نام خانوادگی</th>
            <th>شماره تماس</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr data-id="@user.Id">
                <td><button class="btn btn-update btn-sm btn-edit" data-id="@user.Id">ویرایش</button></td>
                <td><button class="btn btn-delete btn-sm btn-delete" data-id="@user.Id">حذف</button></td>
                <td>@user.FristName</td>
                <td>@user.LastName</td>
                <td>@user.PhoneNumber</td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="userModal" tabindex="-1" role="dialog" aria-labelledby="userModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content form-container">
            <div class="modal-header">
                <h5 class="modal-title" id="userModalLabel">افزودن / ویرایش کاربر</h5>
            </div>
            <div class="modal-body">
                <form id="userForm">
                    <input type="hidden" name="Id" id="Id" />
                    <input type="text" name="Name" id="Name" class="form-control mb-2" placeholder="نام" required />
                    <input type="text" name="LName" id="LName" class="form-control mb-2" placeholder="نام خانوادگی" required />
                    <input type="text" name="PhoneNumber" id="PhoneNumber" class="form-control mb-2" placeholder="تلفن" required />
                    <div class="text-danger" id="errorMessage" style="display:none;"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="submit" form="userForm" class="btn btn-primary">ثبت</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $("#btnAdd").click(function () {
                $("#userForm")[0].reset();
                $("#Id").val(0);
                $("#userModalLabel").text("افزودن کاربر");
                $("#errorMessage").hide();
                $("#userModal").modal("show");
            });

            $(".btn-edit").click(function () {
                var id = $(this).data("id");
                $.get("/User/AddOrEditUser", { id: id }, function (data) {
                    $("#Id").val(data.id);
                    $("#Name").val(data.name);
                    $("#LName").val(data.lName);
                    $("#PhoneNumber").val(data.phoneNumber);
                    $("#userModalLabel").text("ویرایش کاربر");
                    $("#errorMessage").hide();
                    $("#userModal").modal("show");
                });
            });

            $("#userForm").submit(function (e) {
                e.preventDefault();
                $.ajax({
                    url: "/User/AddOrEditUser",
                    type: "POST",
                    data: $(this).serialize(),
                    success: function (res) {
                        if (res.success) {
                            $("#userModal").modal("hide");
                            location.reload();
                        } else {
                            $("#errorMessage").text(res.message).show();
                        }
                    },
                    error: function () {
                        $("#errorMessage").text("خطا در ثبت اطلاعات").show();
                    }
                });
            });

            $(".btn-delete").click(function () {
                var row = $(this).closest("tr");
                var id = $(this).data("id");
                if (!confirm("آیا از حذف اطمینان دارید؟")) return;
                $.post("/User/Delete", { id: id }, function (res) {
                    if (res.success) {
                        row.fadeOut(300, function () { $(this).remove(); });
                    } else {
                        alert("حذف ناموفق بود.");
                    }
                });
            });
        });
    </script>
}
