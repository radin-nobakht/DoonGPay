@model DoonGPay.Entity.UserEntity

<style>
    body {
        direction: rtl;
        font-family: 'B Nazanin', Tahoma, sans-serif;
        background-color: white; /* نارنجی بسیار روشن */
        margin-bottom: 60px;
    }

    /* فرم */
    .form-container {
        width: 400px;
        margin: 50px auto 30px;
        background-color: white; /* نارنجی روشن */
        padding: 20px;
        border-radius: 10px;
        border: 1px solid #ff9800; /* نارنجی */
        box-shadow: 0 0 10px rgba(255, 152, 0, 0.3);
    }

        .form-container h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #e65100; /* نارنجی تیره */
        }

        .form-container input {
            width: 100%;
            padding: 8px;
            margin: 10px 0;
            font-family: 'B Nazanin', Tahoma, sans-serif;
            font-size: 16px;
            border: 1px solid #ffb74d; /* نارنجی روشن */
            border-radius: 8px;
            background-color: #fff8e1; /* پس‌زمینه خیلی روشن نارنجی */
            color: #5d4037; /* قهوه‌ای تیره برای متن */
            transition: border-color 0.3s;
        }

            .form-container input:focus {
                border-color: #ff6f00; /* نارنجی پررنگ */
                outline: none;
                background-color: #fff3e0;
            }

        .form-container button {
            width: 100%;
            padding: 10px;
            background-color: #ff9800; /* نارنجی */
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            .form-container button:hover {
                background-color: #ef6c00; /* نارنجی تیره */
            }

    .error {
        color: #d32f2f; /* قرمز تیره */
        margin-bottom: 10px;
        font-size: 14px;
        display: none;
    }

    /* جدول نارنجی */
    table {
        border-collapse: collapse;
        width: 100%;
        max-width: 900px;
        margin: 0 auto 50px;
        font-family: Tahoma, sans-serif;
        box-shadow: 0 0 8px rgba(255, 152, 0, 0.4);
    }

    th {
        background-color: #ff9800; /* نارنجی */
        color: white;
        padding: 10px;
        border: 1px solid #ffa726;
        text-align: center;
    }

    td {
        padding: 10px;
        border: 1px solid #ffcc80;
        text-align: center;
        color: #5d4037;
    }

    tbody tr:nth-child(even) {
        background-color: #ffe0b2; /* نارنجی خیلی روشن */
    }

    tbody tr:hover {
        background-color: #ffcc80; /* نارنجی متوسط */
    }

    /* دکمه‌ها داخل جدول */
    .btn {
        padding: 5px 10px;
        border-radius: 5px;
        font-size: 14px;
        cursor: pointer;
        border: none;
        color: white;
        transition: background-color 0.3s;
    }

    .btn-update {
        background-color: #fb8c00; /* نارنجی */
    }

    .btn-delete {
        background-color: #e64a19; /* نارنجی قرمز */
    }

    .btn-update:hover {
        background-color: #ef6c00; /* نارنجی تیره */
    }

    .btn-delete:hover {
        background-color: #bf360c; /* نارنجی تیره */
    }

    img.img {
        max-width: 100px;
        height: auto;
        display: block;
        margin: 0 auto;
        border-radius: 5px;
        box-shadow: 0 0 5px rgba(255, 152, 0, 0.5);
    }
</style>

<div class="form-container">
    <h2>@(Model.Id == 0 ? "افزودن مقدار جدید" : "ویرایش مقدار")</h2>
    <form id="dicForm" method="post">
        <input type="hidden" id="Id" name="Id" value="@Model.Id" />
        <input type="text" id="Type" name="Name" placeholder="اسم" value="@Model.FirstName" required />
        <input type="text" id="Name" name="LName" placeholder="نام خوانوادگی" value="@Model.LastName" required />
        <input type="text" id="Img" name="PhoneNumber" placeholder="تلفن" value="@Model.PhoneNumber" required />
        <button type="submit">ثبت</button>
    </form>
    <div class="error" id="errorMessage"></div>
</div>
