@model DoonGPay.Entity.UserEntity

<div class="form-container">
    <h2>@(Model.Id == 0 ? "افزودن مقدار جدید" : "ویرایش مقدار")</h2>
    <form id="dicForm" method="post">
        <input type="hidden" asp-for="Id" />

        <input asp-for="FristName" placeholder="اسم" required />
        <span asp-validation-for="FristName" class="error"></span>

        <input asp-for="LastName" placeholder="نام خانوادگی" required />
        <span asp-validation-for="LastName" class="error"></span>

        <input asp-for="PhoneNumber" placeholder="تلفن" required />
        <span asp-validation-for="PhoneNumber" class="error"></span>

        <button type="submit">ثبت</button>
    </form>
    <div class="error" id="errorMessage"></div>
</div>
