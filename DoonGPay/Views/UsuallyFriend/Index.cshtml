@using DoonGPay.Dto
@model List<UsuallyFriendDto>

<style>
    /* ====== جدول ====== */
    table.table {
        background-color: #ffffff; /* سفید */
        border-collapse: collapse;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        border-radius: 10px;
        overflow: hidden;
    }

        table.table thead {
            background-color: #1e2761; /* سرمه‌ای */
            color: #ffffff;
        }

        table.table th,
        table.table td {
            vertical-align: middle;
            padding: 12px;
            font-size: 14px;
        }

        table.table tbody tr:nth-child(even) {
            background-color: #f8f9fa; /* خاکستری روشن */
        }

        table.table tbody tr:nth-child(odd) {
            background-color: #ffffff;
        }

        table.table tbody tr:hover {
            background-color: #408ec6; /* آبی روشن */
            color: #ffffff;
            transition: 0.2s ease-in-out;
        }

    /* ====== دکمه‌ها ====== */
    button.btn {
        border-radius: 6px !important;
        font-size: 13px !important;
        padding: 6px 14px !important;
        min-width: 70px;
    }

    /* دکمه افزودن */
    button.btn-success {
        background-color: #408ec6;
        border-color: #408ec6;
        color: #ffffff;
    }

        button.btn-success:hover {
            background-color: #1e2761;
            border-color: #1e2761;
        }

    /* دکمه ویرایش */
    button.btn-info {
        background-color: #408ec6;
        border-color: #408ec6;
        color: #ffffff;
    }

        button.btn-info:hover {
            background-color: #1e2761;
            border-color: #1e2761;
        }

    /* دکمه حذف */
    button.btn-danger {
        background-color: #7a2048; /* زرشکی */
        border-color: #7a2048;
        color: #ffffff;
    }

        button.btn-danger:hover {
            background-color: #5c1435;
            border-color: #5c1435;
        }

    button + button {
        margin-right: 5px;
    }

    .mb-3 {
        margin-bottom: 15px !important;
        font-weight: bold;
    }

    img {
        width: 20px;
    }
</style>

<!-- دکمه افزودن -->
<button class="btn btn-success mb-3 btnEditusuallyFriend" id="btnAddusuallyFriend" data-id="0">
    دوستان همیشگی جدید
</button>

<link href="~/css/travel/travelstable.css" rel="stylesheet" />

<!-- جدول دوستان -->
<table class="table table-bordered text-center usuallyFriendRows" id="FtTable">
    <thead>
        <tr>
            <th>نام</th>
            <th>نام خانوادگی</th>
            <th>شماره تلفن</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model)
        {
            <tr data-id="@i.Id" class="usuallyFriend">
                <td>@i.FirstName</td>
                <td>@i.LastName</td>
                <td>@i.PhoneNumber</td>
                <td>
                    <button class="btn btn-info btn-sm btnEditusuallyFriend" data-id="@i.Id">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </button>

                    <button class="btn btn-danger btn-sm btnDeleteUsuallyFriend" data-id="@i.Id">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="~/js/usuallyfriends.js"></script>
}
