@using DoonGPay.Dto
@model List<UsuallyFriendDto>

<style>
    /* وقتی روی ردیف می‌بریم موس */
    tr.usuallyFriend {
        cursor: pointer;
        transition: background-color 0.2s ease-in-out;
    }

    tr.usuallyFriend:hover {
        background-color: #f1f1f1;
    }
</style>

<div class="modal fade" id="usuallyFriendsModal" tabindex="-1" aria-labelledby="usuallyFriendsLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="usuallyFriendsLabel">دوستان همیشگی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <table class="table table-bordered text-center">
                    <thead class="table-dark">
                        <tr>
                            <th>نام</th>
                            <th>شماره تلفن</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model)
                        {
                            <tr data-id="@i.Id" class="usuallyFriend">
                                <td>@($"{i.FirstName} {i.LastName}")</td>
                                <td>@i.PhoneNumber</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>
