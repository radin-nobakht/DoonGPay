@using DoonGPay.Dto
@model UsuallyFriendDto
<link href="~/css/travel/travelsmodals.css" rel="stylesheet" />

<div class="modal fade" aria-hidden="true" id="editUsuallyFriend">
    <div class="modal-dialog" role="document">
        <div class="modal-content form-container" style="background-color:#1e2761; color:#ffffff;">
            <div class="modal-header" style="border-bottom:1px solid #408ec6;">
                <h5 class="modal-title">افزودن / ویرایش دوستان همیشگی</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="usuallyFriendForm">
                    <input type="hidden" asp-for="Id" />
                    <input type="text" asp-for="FirstName" class="form-control mb-3 border-primary" placeholder="نام" required />
                    <input type="text" asp-for="LastName" class="form-control mb-3 border-primary" placeholder="نام خانوادگی" required />
                    <input type="number" asp-for="PhoneNumber" class="form-control mb-3 border-primary" placeholder="شماره تلفن" required />
                    <div class="text-danger" id="errorMessage" style="display:none;"></div>
                </form>
            </div>
            <div class="modal-footer" style="border-top:1px solid #408ec6;">
                <button type="button" id="btnSaveUsuallyFriend" class="btn btn-primary">ثبت</button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/usuallyfriends.js"></script>

<style>
    /* Input focus effect */
    #usuallyFriendForm .form-control:focus {
        border-color: #408ec6;
        box-shadow: 0 0 5px rgba(64, 142, 198, 0.5);
    }

    /* Button hover effect */
    #btnSaveUsuallyFriend:hover {
        background-color: #408ec6;
        border-color: #408ec6;
        transition: all 0.3s ease;
    }
</style>
