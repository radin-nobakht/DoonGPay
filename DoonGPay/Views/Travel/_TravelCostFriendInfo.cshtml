@using DoonGPay.Dto.Travel
@model List<TravelCostFriendDto>

<style>
    /* ردیف‌ها */
    tr.usuallyFriend {
        cursor: pointer;
        transition: background-color 0.2s ease-in-out;
    }

        tr.usuallyFriend:hover {
            background-color: #d0e0ff; /* آبی خیلی روشن */
        }

    /* جدول */
    table.table {
        width: 100%;
        border-collapse: collapse;
        border-radius: 8px;
        overflow: hidden;
    }

        table.table th {
            background-color: #408ec6; /* آبی روشن */
            color: white;
            padding: 10px;
            border: 1px solid #1e2761;
        }

        table.table td {
            padding: 8px;
            border: 1px solid #1e2761;
            color: #1e2761;
        }

    tbody tr:nth-child(even) {
        background-color: #e0e7ff; /* آبی خیلی روشن */
    }

    tbody tr:hover {
        background-color: #d0e0ff;
        transition: 0.2s ease-in-out;
    }

    /* دکمه‌ها */
    .btn-secondary {
        background-color: #7a2048;
        color: white;
        border-radius: 5px;
        transition: 0.3s;
    }

        .btn-secondary:hover {
            background-color: #5e193d;
        }
</style>

<div class="modal fade" id="frinedInfoModal" tabindex="-1" aria-labelledby="frinedInfoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="frinedInfoLabel">اطلاعات هزینه</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body bg-light">
                <table class="table table-bordered text-center">
                    <thead>
                        <tr>
                            <th>اسم هزینه</th>
                            <th>سهم فرد</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model)
                        {
                            <tr class="usuallyFriend">
                                <td>@i.CostName</td>
                                <td>@i.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>
