@using DoonGPay.Dto.Travel
@model TravelFriendDto
<link href="~/css/travel/travelsmodals.css" rel="stylesheet" />
<div class="modal fade" aria-hidden="true" id="editFriend">
    <div class="modal-dialog" role="document">
        <div class="modal-content form-container">
            <div class="modal-header">
                <h5 class="modal-title">افزودن / ویرایش همسفر</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="friendForm">
                    <input type="hidden" asp-for="TravelId" />
                    <input type="hidden" asp-for="Id" />
                    <input type="text" asp-for="FristName" class="form-control mb-3" placeholder="نام" required />
                    <input type="text" asp-for="LastName" class="form-control mb-3" placeholder="نام خانوادگی" required />
                    <input type="number" asp-for="PhoneNumber" class="form-control mb-3" placeholder="شماره تلفن" required />
                    <input type="number" asp-for="Person" class="form-control mb-3" placeholder="تعداد نفرات" required />
                    <div class="text-danger" id="errorMessage" style="display:none;"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnSaveFriend" class="btn btn-success">ثبت</button>
            </div>
        </div>
    </div>
</div>
