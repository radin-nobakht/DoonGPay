@using DoonGPay.Dto.Travel
@model List<TravelCostDto>

<style>
    table.table {
        width: 100%;
        border-collapse: collapse;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 15px;
    }

        table.table th {
            background-color: #408ec6; /* آبی روشن */
            color: white;
            padding: 10px;
            border: 1px solid #1e2761;
        }

        table.table td {
            padding: 8px;
            border: 1px solid #1e2761;
            text-align: center;
            color: #1e2761;
        }

        table.table tbody tr:nth-child(even) {
            background-color: #e0e7ff; /* آبی خیلی روشن */
        }

        table.table tbody tr:hover {
            background-color: #d0e0ff;
            transition: 0.2s ease-in-out;
        }

    /* دکمه‌ها */
    .btn {
        border-radius: 5px;
        font-size: 13px;
        padding: 5px 10px;
        min-width: 70px;
        color: white;
        transition: 0.3s;
    }

    .btn-success {
        background-color: #408ec6;
    }

        .btn-success:hover {
            background-color: #1e2761;
        }

    .btn-info {
        background-color: #7a2048;
    }

        .btn-info:hover {
            background-color: #5e193d;
        }

    .btn-danger {
        background-color: #dc3545;
    }

        .btn-danger:hover {
            background-color: #a71d2a;
        }

</style>

<div name="wer">
    <button class="btn btn-success mb-3 btnTravelCostEdit" id="btnAddCost" data-id="0" data-travel-id="@ViewData["travelId"]">
        هزینه جدید
    </button>

    <table class="table table-bordered text-center">
        <thead>
            <tr>
                <th>ردیف</th>
                <th>عنوان</th>
                <th>مقدار</th>
                <th>وضعیت</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                var raw = 0;
                @foreach (var tc in Model)
                {
                    raw++;
                    <tr data-id="@tc.Id">
                        <td>@raw</td>
                        <td>@tc.Title</td>
                        <td>@string.Format("{0:N0}", tc.Value)</td>
                        <td>@tc.TypeStr</td>
                        <td>
                            <button class="btn btn-info btn-sm btnTravelCostEdit" data-id="@tc.Id" data-travel-id="@tc.TravelId">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            <button class="btn btn-danger btn-sm btnDeleteTravelCost" data-id="@tc.Id" data-travel-id="@tc.TravelId">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
