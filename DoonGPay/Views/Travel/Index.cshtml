@using DoonGPay.Dto.Travel
@model TravelDto
<style>
    body {
        background-image: url('@Url.Action("a", "Travel")');
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
    }
</style>



<div class="p-3  rounded h-100">
    <div id="travels">
        <partial name="_Travel" model="Model" />
    </div>
</div>

@section Scripts {
    <script src="~/js/travel/travel.js"></script>
    <script src="~/js/travel/travelcost.js"></script>
    <script src="~/js/travel/travelfriend.js"></script>
}