@model List<DoonGPay.Dto.TravelFriendDto>
<button class="btn btn-success mb-3" id="btnAddFriend">سفر جدید</button>

<table class="table table-bordered text-center" id="FtTable">
    <thead class="thead-dark">
        <tr>
            <th>ویرایش</th>
            <th>حذف</th>
            <th>اسم</th>
            <th>نام خوانوادگی</th>
            <th>تلفن</th>
            <th>سهم</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model)
        {
            <tr data-id="@i.Id">
                <td>
                    <button class="btn btn-info btn-sm btn-editFriend" data-id="@i.Id">ویرایش</button>
                </td>
                <td>
                    <button class="btn btn-danger btn-sm btn-deleteFriend" data-id="@i.Id">حذف</button>
                </td>
                <td>@i.Name</td>
                <td>@i.LastName</td>
                <td>@i.PhoneNumber</td>
                <td>@i.Share</td>
            </tr>
        }
    </tbody>
</table>
