@using DoonGPay.Dto.Travel
@model TravelDto
<link href="~/css/travel/travelsmodals.css" rel="stylesheet" />
<div class="modal fade" aria-hidden="true" id="editTravel">
    <div class="modal-dialog" role="document">
        <div class="modal-content form-container shadow rounded-3 border-0">
            <div class="modal-header bg-dark text-white rounded-top">
                <h5 class="modal-title">افزودن / ویرایش سفر</h5>
                <button type="button" class="btn-close btn-close-white" style="margin:0;" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body bg-light">
                <form id="travelForm">
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Id" />

                    <input type="text" asp-for="Name" class="form-control mb-3" placeholder="نام سفر" required />
           

                    <input type="text" asp-for="InsertDate" class="form-control mb-3" placeholder="تاریخ" required />
                    

                    <div class="text-danger small" id="errorMessage" style="display:none;"></div>
                </form>
            </div>

            <div class="modal-footer bg-light">
                <button type="button" id="btnSaveTravel" class="btn btn-success px-4">ثبت</button>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script>
                   $("#InsertDate").persianDatepicker({
            format: "YYYY/MM/DD",    // فقط سال/ماه/روز
            initialValue: false,     // اگر میخوای هیچ مقدار پیش‌فرض نداشته باشه
            autoClose: true,         // بعد از انتخاب بسته شود
            persianDigit: false,     // اعداد انگلیسی (1404/06/01)
            timePicker: {
                enabled: false       // غیرفعال کردن ساعت و دقیقه
            },
            altField: "#GregorianDate",
            altFormat: "YYYY-MM-DD" // برای ارسال میلادی به سرور
        });

    </script>
}
