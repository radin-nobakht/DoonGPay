@using DoonGPay.Dto.Travel
@model TravelDto

<link href="~/css/travel/travelsmodals.css" rel="stylesheet" />

<style>
    /* فرم مودال */
    .form-container {
        border-radius: 10px;
        padding: 0;
        overflow: hidden;
    }

    /* هدر مودال */
    .modal-header {
        background-color: #1e2761; /* آبی تیره */
        color: white;
        border-bottom: none;
    }

        .modal-header h5 {
            color: #408ec6; /* آبی روشن */
        }

        .modal-header .btn-close {
            filter: invert(1); /* برای دکمه سفید */
        }

    /* بدنه مودال */
    .modal-body {
        background-color: #f0f4ff; /* آبی خیلی روشن */
    }

        .modal-body input {
            width: 100%;
            padding: 8px;
            margin-bottom: 12px;
            border: 1px solid #408ec6;
            border-radius: 6px;
            font-size: 14px;
            transition: border-color 0.3s;
            background-color: white;
            color: #1e2761;
        }

            .modal-body input:focus {
                border-color: #7a2048; /* بنفش/شرابی */
                outline: none;
                background-color: #e0e7ff;
            }

    /* پیام خطا */
    #errorMessage {
        color: #7a2048;
        font-size: 13px;
    }

    /* فوتر مودال */
    .modal-footer {
        background-color: #f0f4ff;
        border-top: none;
    }

        .modal-footer .btn {
            background-color: #408ec6;
            color: white;
            border-radius: 6px;
            padding: 6px 20px;
            font-size: 14px;
        }

            .modal-footer .btn:hover {
                background-color: #1e2761;
            }
</style>

<div class="modal fade" aria-hidden="true" id="editTravel">
    <div class="modal-dialog" role="document">
        <div class="modal-content form-container shadow rounded-3 border-0">
            <div class="modal-header rounded-top">
                <h5 class="modal-title">افزودن / ویرایش سفر</h5>
                <button type="button" class="btn-close" style="margin:0;" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form id="travelForm">
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Id" />

                    <input type="text" asp-for="Name" class="form-control" placeholder="نام سفر" required />
                    <input type="text" asp-for="InsertDate" class="form-control" placeholder="تاریخ" id="InsertDate" required />

                    <div class="text-danger small" id="errorMessage" style="display:none;"></div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" id="btnSaveTravel" class="btn">ثبت</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(function() {
        $("#InsertDate").persianDatepicker({
            format: "YYYY/MM/DD",
            initialValue: false,
            autoClose: true,
            persianDigit: false,
            timePicker: { enabled: false },
            altField: "#GregorianDate",
            altFormat: "YYYY-MM-DD"
        });
    });
</script>
