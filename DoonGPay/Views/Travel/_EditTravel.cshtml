@using DoonGPay.Dto.Travel
@model TravelDto
<div class="modal fade" aria-hidden="true" id="editTravel">
    <div class="modal-dialog" role="document">
        <div class="modal-content form-container">
            <div class="modal-header">
                <h5 class="modal-title">افزودن / ویرایش سفر</h5>
            </div>
            <div class="modal-body">
                <form id="travelForm">
                    <input type="hidden" asp-for=UserId />
                    <input type="hidden" asp-for=Id />
                    <input type="text" asp-for=Name class="form-control mb-2" placeholder="نام" required />
                    <input type="date" asp-for=Date class="form-control mb-2" placeholder="تاریخ وارد شدن" required />
                    <div class="text-danger" id="errorMessage" style="display:none;"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnSaveTravel" class="btn btn-primary">ثبت</button>
            </div>
        </div>
    </div>
</div>