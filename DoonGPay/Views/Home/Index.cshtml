@using DoonGPay.Dto.Travel
@model TravelDto
@{
    ViewData["Title"] = "خانه";
}

<div class="text-center">
    <h1 class="display-4 mb-4" style="color:#1e2761;">به DoonGPay خوش آمدید!</h1>
    <p class="lead mb-5" style="color:#333;">بهترین سرویس پرداخت آنلاین در ایران با امنیت بالا و سرعت بی‌نظیر.</p>
    <a href="/Home/About" class="btn btn-primary btn-lg">بیشتر بدانید</a>
</div>

<div class="row mt-5">
    <div class="col-md-4 text-center">
        <img src="~/images/security.svg" alt="امنیت" style="width:80px" />
        <h4 class="mt-3" style="color:#408ec6;">امنیت بالا</h4>
        <p>پرداخت‌های امن و محافظت شده با جدیدترین فناوری‌ها.</p>
    </div>
    <div class="col-md-4 text-center">
        <img src="~/images/speed.svg" alt="سرعت" style="width:80px" />
        <h4 class="mt-3" style="color:#408ec6;">سرعت بی‌نظیر</h4>
        <p>تسویه حساب در سریع‌ترین زمان ممکن بدون معطلی.</p>
    </div>
    <div class="col-md-4 text-center">
        <img src="~/images/support.svg" alt="پشتیبانی" style="width:80px" />
        <h4 class="mt-3" style="color:#408ec6;">پشتیبانی ۲۴ ساعته</h4>
        <p>تیم پشتیبانی ما همیشه آماده پاسخگویی به شماست.</p>
    </div>
</div>

