<style>
    a {
        text-decoration: none;
    }

    html {
        font-size: 16px;
        position: relative;
        min-height: 100%;
    }

    body {
        direction: rtl;
        font-family: 'B Nazanin', Tahoma, sans-serif;
        background-color: white;
        margin-bottom: 60px;
    }

    .btn:focus, .btn:active:focus, .btn-link.nav-link:focus, .form-control:focus, .form-check-input:focus {
        box-shadow: 0 0 0 0.1rem white, 0 0 0 0.25rem #258cfb;
    }

    .form-container {
        width: 400px;
        margin: 50px auto 30px;
        background-color: white;
        padding: 20px;
        border-radius: 10px;
        border: 1px solid #ff9800;
        box-shadow: 0 0 10px rgba(255, 152, 0, 0.3);
    }

        

    table {
        border-collapse: collapse;
        width: 100%;
        max-width: 900px;
        margin: 0 auto 50px;
        font-family: Tahoma, sans-serif;
        box-shadow: 0 0 8px rgba(255, 152, 0, 0.4);
    }

    th {
        background-color: #ff9800;
        color: white;
        padding: 10px;
        border: 1px solid #ffa726;
        text-align: center;
    }

    td {
        padding: 10px;
        border: 1px solid #ffcc80;
        text-align: center;
        color: #5d4037;
    }


    tbody tr:hover {
        background-color: #ffcc80;
    }

    .btn {
        padding: 5px 10px;
        border-radius: 5px;
        font-size: 14px;
        cursor: pointer;
        border: none;
        color: white;
        transition: background-color 0.3s;
    }

    .btn-update {
        background-color: #fb8c00;
    }

        .btn-update:hover {
            background-color: #ef6c00;
        }

    .btn-delete {
        background-color: #e64a19;
    }

        .btn-delete:hover {
            background-color: #bf360c;
        }
</style>
<button class="btn btn-success mb-3" id="btnAdd">کاربر جدید</button>

<table class="table table-bordered text-center" id="userTable">
    <thead class="thead-dark">
        <tr>
            <th>ویرایش</th>
            <th>حذف</th>
            <th>نام</th>
            <th>نام خانوادگی</th>
            <th>شماره تماس</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in ViewBag.UserList)
        {
            <tr data-id="@user.Id">
                <td>
                    <button class="btn btn-info btn-sm btn-edit" data-id="@user.Id">ویرایش</button>
                </td>
                <td>
                    <button class="btn btn-danger btn-sm btn-delete" data-id="@user.Id">حذف</button>
                </td>
                <td>@user.Name</td>
                <td>@user.LName</td>
                <td>@user.PhoneNumber</td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="userModal" tabindex="-1" role="dialog" aria-labelledby="userModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content form-container">
            <div class="modal-header">
                <h5 class="modal-title" id="userModalLabel">افزودن / ویرایش کاربر</h5>
            </div>
            <div class="modal-body">
                <form id="userForm">
                    <input type="hidden" name="Id" id="Id" />
                    <input type="text" name="Name" id="Name" class="form-control mb-2" placeholder="نام" required />
                    <input type="text" name="LName" id="LName" class="form-control mb-2" placeholder="نام خانوادگی" required />
                    <input type="text" name="PhoneNumber" id="PhoneNumber" class="form-control mb-2" placeholder="تلفن" required />
                    <div class="text-danger" id="errorMessage" style="display:none;"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="submit" form="userForm" class="btn btn-primary">ثبت</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {

            // افزودن
            $("#btnAdd").click(function () {
                $("#userForm")[0].reset();
                $("#Id").val(0);
                $("#userModalLabel").text("افزودن کاربر");
                $("#errorMessage").hide();
                $("#userModal").modal("show");
            });

            // ویرایش
            $(".btn-edit").click(function () {
                var id = $(this).data("id");
                $.get("/Home/AddOrEditUser", { id: id }, function (data) {
                    $("#Id").val(data.id);
                    $("#Name").val(data.name);
                    $("#Name").val(data.name);
                    $("#LName").val(data.lName);
                    $("#PhoneNumber").val(data.phoneNumber);
                    $("#userModalLabel").text("ویرایش کاربر");
                    $("#errorMessage").hide();
                    $("#userModal").modal("show");
                });
            });

            // ارسال فرم
            $("#userForm").submit(function (e) {
                e.preventDefault();
                $.ajax({
                    url: "/Home/AddOrEditUser",
                    type: "POST",
                    data: $(this).serialize(),
                    success: function (res) {
                        if (res.success) {
                            $("#userModal").modal("hide");
                            location.reload(); // در صورت نیاز به رفرش جدول بدون reload بگو تا اونم پیاده‌سازی کنم
                        } else {
                            $("#errorMessage").text(res.message).show();
                        }
                    },
                    error: function () {
                        $("#errorMessage").text("خطا در ثبت اطلاعات").show();
                    }
                });
            });

            // حذف
            $(".btn-delete").click(function () {
                var row = $(this).closest("tr");
                var id = $(this).data("id");
                if (!confirm("آیا از حذف اطمینان دارید؟")) return;

                $.post("/Home/Delete", { id: id }, function (res) {
                    if (res.success) {
                        row.fadeOut(300, function () {
                            $(this).remove();
                        });
                    } else {
                        alert("حذف ناموفق بود.");
                    }
                });
            });

        });
    </script>
}