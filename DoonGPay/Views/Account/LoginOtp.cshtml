@using DoonGPay.Dto
@model LoginDto
@{
    Layout = "_Layout2";
}

<div class="form-container">
    <div>
        <img src="~/Image/login.png" alt="Login" />
    </div>
    <div id="errorMsg">@ViewBag.eror</div>
    <form>
        <label for="phoneNumber">شماره موبایل:</label>
        <input type="number" id="txtPhoneNumber" required asp-for=PhoneNumber placeholder="شماره موبایل" />
        <label id="lblCode" class="d-none">کد</label>
        <input type="number" class="d-none" id="txtCode" asp-for=Code placeholder="کد دریافتی را وارد نمایی">
        <button type="button" id="btnSendCode">ارسال</button>
        <button type="button" class="d-none" id="btnLoginOtp">ارسال کد</button>
        <a href="/User/Signin">ثبت نام</a>
    </form>
</div>

@section Scripts
{
    <script>
        $("#btnSendCode").click(function(){
          $.ajax({
            type: "POST",
            url: "/Account/LoginSendCode",
            data:{
                PhoneNumber:$("#txtPhoneNumber").val()
            },
            success: function (result) {
                if(result.result)
                {
                    $("#lblCode").removeClass("d-none");
                    $("#txtCode").removeClass("d-none");
                    $("#btnLoginOtp").removeClass("d-none");
                    $("#btnSendCode").addClass("d-none");
                    $("#txtPhoneNumber").attr("disabled",true);
                }
                else
                alert(result.message);
            },
            error: function () {


            }
        });

        })
        $("#btnLoginOtp").click(function(){
          $.ajax({
            type: "POST",
            url: "/Account/LoginOtp",
            data:{
                PhoneNumber:$("#txtPhoneNumber").val(),
                Code:$("#txtCode").val()
            },
            success: function (result) {
                if(result.result)
                {
                    window.location.reload("/Home");
                    window.location.href="/Home";
                }
                 else
                alert(result.message);

            },
            error: function () {


            }
        });

        })


    </script>
}

