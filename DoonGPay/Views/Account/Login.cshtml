@{
    Layout = "_Layout2";
}


<div class="form-container">
   <div>
        <img src="~/Image/login.png" alt="Login" />
   </div>
    <div id="errorMsg">@ViewBag.eror</div>
    <form id="loginForm" method="post" action="/User/Login">
        <label for="name">نام:</label>
        <input type="text" id="name" name="name" placeholder="نام" />

        <label for="LName">نام خوانوادگی:</label>
        <input type="text" id="LName" name="LName" placeholder="نام خوانوادگی" />

        <label for="phoneNumber">شماره موبایل:</label>
        <input type="number" id="phoneNumber" name="phoneNumber" placeholder="شماره موبایل" />

        <button type="submit">ارسال</button>
        <a href="/User/Signin">ثبت نام</a>




    </form>
</div>

@section Scripts
{
    <script>
               $('#loginForm').click( function() {
            const name = $('#name').val().trim();
            const LName = $('#LName').val().trim();
            const phoneNumber = $('#phoneNumber').val().trim();
            const errorDiv = $('#errorMsg');

            if (!name || !LName || !phoneNumber) {
                errorDiv.text("لطفاً همه فیلدها را پر کنید.");
                return;
            }

            errorDiv.text("");
        });

    </script>
}

